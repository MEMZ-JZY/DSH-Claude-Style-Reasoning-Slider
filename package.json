{
  "name": "dsh-client-ui-effort-slider",
  "version": "0.5.0",
  "description": "Animated reasoning-level slider for DeepSeek Harness model selection.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "cordis.patch.yml", "lib/client.js", "README.md"],
  "scripts": { "build": "node scripts/build-client.mjs", "prepare": "node scripts/build-client.mjs" },
  "publishConfig": { "access": "public" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-cordis-client-runner"
      ]
    }
  },
  "license": "MIT"
}
